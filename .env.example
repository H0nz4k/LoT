HANZHUB_IOT_PORT=4011
HANZHUB_IOT_URL=http://192.168.1.3:4011
HANZHUB_DASHBOARD_API=http://127.0.0.1:4010
HANZHUB_DASHBOARD_URL=http://192.168.1.3:4001
TINYTUYA_DEVICES_FILE=/opt/infrapanel/devices.json

# Optional remote controls through Cloudflare Access (disabled until configured).
# Team domain: e.g. your-team.cloudflareaccess.com; AUD from the IoT Access app.
HANZHUB_ACCESS_TEAM_DOMAIN=
HANZHUB_ACCESS_AUD=
HANZHUB_ACCESS_ORIGIN=https://iot.hanzhub.cz
# Optional: restrict to these verified token emails, comma-separated.
# Empty means users admitted by this specific Access application's policy.
HANZHUB_ACCESS_ALLOWED_EMAILS=
